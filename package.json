{
  "name": "multimodal-cardiovascular-risk-visualization",
  "version": "1.0.0",
  "description": "Interactive 3D Cardiovascular Risk Visualization and Multi-Target Prediction Platform (Track A - Multimodal AI Hackathon 2026)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "python -m uvicorn apps.api.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "tsc -b && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test:api": "python -m pytest apps/api/tests -v",
    "test:leakage": "python -m pytest apps/api/tests/test_leakage.py -v",
    "optimize:mesh": "node scripts/optimize_mesh.mjs",
    "preprocess:data": "python scripts/preprocess.py --strict-leakage-check",
    "train:models": "python scripts/train.py --cv-folds 5 --calibrate isotonic"
  },
  "dependencies": {
    "@react-three/drei": "^9.102.6",
    "@react-three/fiber": "^8.16.8",
    "@tanstack/react-query": "^5.28.4",
    "clsx": "^2.1.0",
    "lucide-react": "^0.358.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "three": "^0.162.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.162.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.6"
  }
}
