# ==============================================================================
# Multi-Stage Dockerfile for Perfusion3D Web Frontend (Task D2)
# ==============================================================================

# --- Stage 1: Build React 18 + Three.js WebGL Frontend ---
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root dependency manifests
COPY package.json package-lock.json ./

# Clean install dependencies
RUN npm ci

# Copy web source and build configuration
COPY apps/web ./apps/web

# Build static production bundle into apps/web/dist
RUN npm run build:web

# --- Stage 2: Production Nginx Server ---
FROM nginx:alpine AS runner

# Remove default nginx static html files
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder stage
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy custom Nginx configuration with /api reverse proxy and SPA routing
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
